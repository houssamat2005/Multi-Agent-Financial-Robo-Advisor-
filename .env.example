# ============================================================
# Robo-Advisor — Variables d'environnement
# Copier ce fichier en .env et remplir les valeurs
# JAMAIS committer le fichier .env
# ============================================================

# === PostgreSQL ===
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=roboadvisor
DATABASE_URL=postgresql+asyncpg://postgres:${POSTGRES_PASSWORD}@localhost:5432/roboadvisor

# === Redis ===
REDIS_URL=redis://localhost:6379

# === Neo4j ===
NEO4J_URL=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# === ChromaDB ===
CHROMA_HOST=localhost
CHROMA_PORT=8001

# === Kafka ===
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# === Sécurité JWT ===
JWT_SECRET_KEY=npx create-supertokens-app@latest
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# === APIs externes ===
GROQ_API_KEY=your_groq_api_key_here
NEWS_API_KEY=your_news_api_key_here

# === LangSmith (monitoring LangGraph) ===
LANGCHAIN_API_KEY=
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=robo-advisor

# === MLflow ===
MLFLOW_TRACKING_URI=http://localhost:5000

# === Application ===
APP_ENV=development
LOG_LEVEL=INFO
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:5173
